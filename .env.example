# These are retrieved from your project at app.tina.io
NEXT_PUBLIC_TINA_CLIENT_ID=***
TINA_TOKEN=***

# This is set by default CI with Netlify/Vercel/Github, but can be overriden
NEXT_PUBLIC_TINA_BRANCH=***
# To see the preview functionality
VERCEL_ENV=preview

LOCAL_CONTENT_RELATIVE_PATH=../../SSW.Rules.Content

NEXT_PUBLIC_ALGOLIA_APP_ID={{APP_ID}}
NEXT_PUBLIC_ALGOLIA_API_KEY={{API_KEY}}
NEXT_PUBLIC_ALGOLIA_ADMIN_KEY={{ADMIN_KEY}}
NEXT_PUBLIC_ALGOLIA_INDEX_NAME={{INDEX_NAME}}

NEXT_PUBLIC_API_BASE_URL={{API_BASE_URL}}
NEXT_PUBLIC_BASE_PATH={{BASE_PATH}}

AUTH0_DOMAIN=#{{AUTH0_DOMAIN}}
AUTH0_AUDIENCE=#{{AUTH0_AUDIENCE}}
AUTH0_CLIENT_ID=#{{AUTH0_CLIENT_ID}}
AUTH0_REDIRECT_URI=#{{AUTH0_REDIRECT_URI}}
AUTH0_CLIENT_SECRET=#{{AUTH0_CLIENT_SECRET}}
AUTH0_SECRET=#{{AUTH0_SECRET}}

GITHUB_API_PAT=#{{GITHUB_API_PAT}}
GH_APP_ID=#{{GH_APP_ID}}
GH_APP_PRIVATE_KEY=#{{GH_APP_PRIVATE_KEY}}

NEXT_PUBLIC_GITHUB_ORG=#{{NEXT_PUBLIC_GITHUB_ORG}}
NEXT_PUBLIC_GITHUB_REPO=#{{NEXT_PUBLIC_GITHUB_REPO}}

NEXT_PUBLIC_GISCUS_REPO_NAME=#{{NEXT_PUBLIC_GISCUS_REPO_NAME}}
NEXT_PUBLIC_GISCUS_REPO_ID=#{{NEXT_PUBLIC_GISCUS_REPO_ID}}
NEXT_PUBLIC_GISCUS_CATEGORY_ID=#{{NEXT_PUBLIC_GISCUS_CATEGORY_ID}}
NEXT_PUBLIC_GISCUS_THEME_URL=#{{NEXT_PUBLIC_GISCUS_THEME_URL}}

CRM_APP_ID=#{{CRM_APP_ID}}
CRM_TENANT=#{{CRM_TENANT}}
CRM_TENANT_ID=#{{CRM_TENANT_ID}}
CRM_APP_SECRET=#{{CRM_APP_SECRET}}
CRM_SCOPE=#{{CRM_SCOPE}}
CRM_VIEW_CURRENT=#{{CRM_VIEW_CURRENT}}
CRM_VIEW_PAST=#{{CRM_VIEW_PAST}}

NEXT_PUBLIC_GTM_CONTAINER_ID=#{{ NEXT_PUBLIC_GTM_CONTAINER_ID }}

# Application Insights connection string for telemetry (both client & server)
# NOTE: Automatically disabled in local development (NODE_ENV=development)
# Only required for staging/production environments
NEXT_PUBLIC_APPLICATIONINSIGHTS_CONNECTION_STRING=#{{APPLICATIONINSIGHTS_CONNECTION_STRING}}

# The Rulekeeper (Rules Chat) database. Aspire sets these when it runs the index (pnpm aspire, see
# docs/rulekeeper/local-development.md); set them here only to run pnpm rules-chat:index yourself. The local password is in
# the AppHost's user secrets: dotnet user-secrets list --project src/RulesChat/RulesChat.AppHost
# On Azure, leave the user and password unset: the site signs in with its managed identity.
RULES_CHAT_SQL_SERVER=localhost
RULES_CHAT_SQL_PORT=14333
RULES_CHAT_SQL_DATABASE=RulesChat
RULES_CHAT_SQL_USER=sa
RULES_CHAT_SQL_PASSWORD=#{{RULES_CHAT_SQL_PASSWORD}}
# "true" accepts a self-signed SQL Server certificate. Local development only; leave unset anywhere else.
RULES_CHAT_SQL_TRUST_CERTIFICATE=true

# The Rulekeeper's models, through any OpenAI-compatible API. Locally: Ollama with bge-m3 (1024 dimensions, so leave
# RULES_CHAT_EMBEDDING_DIMENSIONS unset). On Azure, leave the API key unset: calls sign in with the managed identity.
RULES_CHAT_AI_BASE_URL=http://localhost:11434/v1
RULES_CHAT_AI_API_KEY=ollama
RULES_CHAT_EMBEDDING_MODEL=bge-m3
RULES_CHAT_EMBEDDING_DIMENSIONS=
RULES_CHAT_CHAT_MODEL=qwen3.5:9b
# Ollama only honours max_tokens and accepts a temperature. Leave both unset for Foundry's reasoning models.
RULES_CHAT_MAX_TOKENS_PARAMETER=max_tokens
RULES_CHAT_TEMPERATURE=0.2
# Optional. "none" makes local reasoning models answer much faster; leave unset for models that reject it.
RULES_CHAT_REASONING_EFFORT=none
# On Azure only: the client ID of the managed identity the site signs in to SQL and Foundry with.
RULES_CHAT_IDENTITY_CLIENT_ID=

# The Rulekeeper's switch and limits. Read at runtime, so they change without a rebuild.
RULES_CHAT_ENABLED=false
# "true" lets any signed-in user in without the CRM employee check. Only a development server honours it.
RULES_CHAT_DEV_ACCESS=false
# Questions a day for signed-in GitHub users who aren't SSW staff. 0 keeps The Rulekeeper to staff.
RULES_CHAT_MEMBER_DAILY_LIMIT=0
# Non-staff are paused for the rest of the month once the estimated cost reaches this.
RULES_CHAT_MONTHLY_BUDGET_USD=100
RULES_CHAT_INPUT_PRICE_PER_MILLION_TOKENS_USD=0
RULES_CHAT_OUTPUT_PRICE_PER_MILLION_TOKENS_USD=0
